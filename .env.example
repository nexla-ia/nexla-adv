# Nexla Adv — variáveis de ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# .env NUNCA é commitado.

# ------ Front-end (bundle Vite — APENAS chaves públicas) ------
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# ------ Server-only (sem prefixo VITE_) ------
# Usar somente em scripts/edge functions. Nunca importar em src/.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
